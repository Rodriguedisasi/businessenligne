{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-static.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__bePath=/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api/index?__bePath=/uploads/$1" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "env": {
    "NODE_ENV": "production",
    "DB_DRIVER": "firebase",
    "STORAGE_DRIVER": "firestore"
  }
}
